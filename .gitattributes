# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files for Flutter/Dart project
*.dart text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.h text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Windows-specific files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.zip binary
*.jar binary
*.so binary
*.dll binary
*.a binary
*.dylib binary